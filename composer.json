{
    "name": "atoolo/crawler-teaser-indexer",
    "version": "1.0.2",
    "description": "Automated crawler-based generation and indexing to Solr.",
    "type": "symfony-bundle",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "atoolo/search-bundle": ">=1.14.2",
        "spatie/robots-txt": ">=2.5.4",
        "symfony/console": ">=6.4.42",
        "symfony/css-selector": ">=6.4.34",
        "symfony/dom-crawler": ">=6.4.40",
        "symfony/dotenv": ">=6.4.42",
        "symfony/flex": ">=2.10",
        "symfony/framework-bundle": ">=6.4.42",
        "symfony/http-client": ">=6.4.42",
        "symfony/monolog-bundle": ">=3.11.2",
        "symfony/runtime": ">=6.4.41",
        "symfony/yaml": ">=6.4.42"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "infection/extension-installer": true,
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.1"
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Atoolo\\Crawler\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atoolo\\Cralwer\\Tests\\": "tests/"
        }
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
        "infection/infection": "^0.29.9",
        "phpcompatibility/php-compatibility": "^9.3.5",
        "phpdocumentor/type-resolver": "^2.0",
        "phpunit/phpunit": "^10.5.64",
        "squizlabs/php_codesniffer": "^3.13.5"
    },
    "scripts": {
        "post-install-cmd": "phive --no-progress install --force-accept-unsigned --trust-gpg-keys C00543248C87FB13,4AA394086372C20A,CF1A108D0E7AE720,51C67305FFC2E5C0,E82B2FB314E9906E",
        "analyse": [
            "@analyse:phplint",
            "@analyse:phpstan",
            "@analyse:php-cs-checker",
            "@analyse:compatibilitycheck"
        ],
        "analyse:compatibilitycheck": "./vendor/bin/phpcs --standard=phpcs.compatibilitycheck.xml",
        "analyse:phplint": "./tools/phplint",
        "analyse:phpstan": "./tools/phpstan analyse",
        "analyse:php-cs-checker": "./vendor/bin/php-cs-fixer check --diff --show-progress=dots",
        "php-cs-fixer": "./vendor/bin/php-cs-fixer fix",
        "report": [
            "@report:phpstan"
        ],
        "report:phpstan": "./tools/phpstan analyse --no-progress --no-ansi --no-interaction --error-format=checkstyle > ./var/log/phpstan-report.xml || exit 0",
        "test": [
            "@test:phpunit"
        ],
        "test:infection": "vendor/bin/infection --threads=8 --no-progress --only-covered -s || exit 0",
        "test:phpunit": "vendor/bin/phpunit -c phpunit.xml --coverage-text",
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    }
}
